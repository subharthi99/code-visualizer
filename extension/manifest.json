{
  "manifest_version": 3,
  "name": "Code Visualizer \u2014 Study this problem",
  "version": "0.3.0",
  "description": "Capture a LeetCode link and reason through the problem with hints, algorithm notes, edge cases, and manual dry runs.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting"
  ],
  "action": {
    "default_title": "Study this problem"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'"
  }
}
